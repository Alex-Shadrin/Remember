<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Remember</RootNamespace>
    <AssemblyName>Remember</AssemblyName>
    <TargetFrameworkVersion>v4.7.2</TargetFrameworkVersion>
    <LangVersion>7.3</LangVersion>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <Optimize>true</Optimize>
    <DebugType>pdbonly</DebugType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>assets\Remember.ico</ApplicationIcon>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <Deterministic>true</Deterministic>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" /><Reference Include="System.Core" />
    <Reference Include="System.Runtime.Serialization" /><Reference Include="System.Xml" />
    <Reference Include="System.Drawing" /><Reference Include="System.Windows.Forms" />
    <Reference Include="WindowsBase" /><Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" /><Reference Include="System.Xaml" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="src\Core.cs" /><Compile Include="src\Storage.cs" />
    <Compile Include="src\Program.cs" /><Compile Include="src\Ui.cs" />
    <Compile Include="src\MainWindow.cs" /><Compile Include="src\Dialogs.cs" />
    <Compile Include="src\Preferences.cs" />
    <Compile Include="src\AssemblyInfo.cs" />
    <EmbeddedResource Include="src\Theme.xaml"><LogicalName>Remember.Theme.xaml</LogicalName></EmbeddedResource>
    <None Include="App.config" />
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
